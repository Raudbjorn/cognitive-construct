# Rhetoric: The Reasoning Engine
# Environment Variables Configuration
#
# For deliberation, configure at least 2 API keys from the providers below.

# =============================================================================
# LLM Provider API Keys (configure at least 2 for deliberation)
# =============================================================================

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Google Cloud / Gemini - https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_API_KEY=AIza...
# Or use GEMINI_API_KEY instead:
# GEMINI_API_KEY=AIza...

# =============================================================================
# Local Model Servers (alternative to cloud APIs)
# =============================================================================

# Ollama - https://ollama.ai
OLLAMA_URL=http://localhost:11434

# LM Studio - https://lmstudio.ai
LMSTUDIO_URL=http://localhost:1234

# =============================================================================
# Toulmin Validation Engine (optional — only needed for 'plan' command)
# =============================================================================

# Inception Labs Mercury API - https://www.inceptionlabs.ai
# Required for: argument decomposition (plan) and analogy bridge
# NOT required for: validate, demo, deliberate, status
INCEPTION_API_KEY=...
